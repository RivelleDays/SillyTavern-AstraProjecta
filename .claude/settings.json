{
  "permissions": {
    "allow": [
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run test*)",
      "Bash(npm test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run i18n*)",
      "Bash(npm run format*)",
      "Bash(npm run check:*)",
      "Bash(npm run generate:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git stash list*)",
      "PowerShell(npm run build*)",
      "PowerShell(npm run dev*)",
      "PowerShell(npm run test*)",
      "PowerShell(npm test*)",
      "PowerShell(npm run typecheck*)",
      "PowerShell(npm run i18n*)",
      "PowerShell(npm run format*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.cjs\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/inject-nearest-agents.cjs\"",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/commit-guard.cjs\"",
            "if": "Bash(git commit*)",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
