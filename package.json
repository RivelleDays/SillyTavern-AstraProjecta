{
	"name": "sillytavern-astraprojecta",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.14.0",
		"radix-ui": "^1.4.3",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"tailwind-merge": "^3.5.0",
		"vaul": "^1.1.2"
	},
	"scripts": {
		"build": "webpack --mode production",
		"check:scoped-preflight": "node ./scripts/generate-scoped-tailwind-preflight.mjs --check",
		"check:st-shared-helpers": "node ./scripts/check-st-shared-helpers.mjs",
		"dev": "webpack --mode development --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:scoped-preflight": "node ./scripts/generate-scoped-tailwind-preflight.mjs",
		"i18n": "node ./scripts/manage-i18n.mjs",
		"prebuild": "npm run i18n && npm run check:st-shared-helpers && npm run generate:scoped-preflight",
		"predev": "npm run i18n && npm run generate:scoped-preflight",
		"pretest": "npm run i18n && npm run check:st-shared-helpers",
		"pretest:run": "npm run i18n && npm run check:st-shared-helpers",
		"pretypecheck": "npm run i18n && npm run check:st-shared-helpers",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"eslintConfig": {
		"extends": [
			"react-app"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@babel/plugin-proposal-private-property-in-object": "^7.21.11",
		"@babel/preset-env": "^7.24.0",
		"@babel/preset-react": "^7.23.3",
		"@babel/preset-typescript": "^7.28.5",
		"@tailwindcss/postcss": "^4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"babel-loader": "^9.1.3",
		"css-loader": "^7.1.4",
		"eslint-config-react-app": "^7.0.1",
		"jsdom": "^27.0.1",
		"mini-css-extract-plugin": "^2.10.2",
		"postcss": "^8.5.9",
		"postcss-loader": "^8.2.1",
		"prettier": "^3.8.3",
		"shadcn": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"terser-webpack-plugin": "^5.3.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4",
		"webpack": "^5.106.1",
		"webpack-cli": "^5.1.4"
	}
}
